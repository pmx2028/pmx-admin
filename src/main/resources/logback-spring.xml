<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    <turboFilter class="com.paramount.pmx.logging.StaticResourceTurboFilter">
        <excludePrefix>/static/</excludePrefix>
        <excludePrefix>/css/</excludePrefix>
        <excludePrefix>/js/</excludePrefix>
        <excludePrefix>/images/</excludePrefix>
        <excludePrefix>/fonts/</excludePrefix>
        <excludePrefix>/assets/</excludePrefix>
        <excludePrefix>/vendor/</excludePrefix>
        <excludePrefix>/data/</excludePrefix>
        <excludePrefix>/actuator/</excludePrefix>
    </turboFilter>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root"/>
    <springProperty scope="context" name="LOG_PATH" source="logging.file.path"/>
    <!--
    <springProperty scope="context" name="LOG_SQL" source="logging.level.org.hibernate.SQL"/>
    -->

    <property name="SUB_LOG_PATH" value="${LOG_PATH}/paramount"/>
    <property name="LOG_FILE_NAME" value="paramount_pmx_log"/>
    <property name="ERR_LOG_FILE_NAME" value="paramount_pmx_log_error"/>
    <property name="SCHEDULER_LOG_FILE_NAME" value="paramount_pmx_schedule_log"/>
    <property name="SCHEDULER_ERR_LOG_FILE_NAME" value="paramount_pmx_scheduler_log_error"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="MAX_DAY" value="7"/>
    <property name="MAX_SIZE" value="10MB"/>

    <!-- 콘솔 로그 (색상 포함) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%green(%d{yyyy-MM-dd HH:mm:ss.SSS}) [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 일반 파일 로그 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- scheduler MDC 로그는 일반 로그에서 제외 -->
        <filter class="com.paramount.pmx.logging.MdcFilter">
            <mdcKey>logType</mdcKey>
            <mdcValue>scheduler</mdcValue>
            <acceptOnMatch>false</acceptOnMatch>
        </filter>
        <file>${SUB_LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SUB_LOG_PATH}/${LOG_FILE_NAME}_%d{yyyy-MM-dd}_%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>${MAX_SIZE}</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>${MAX_DAY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 에러 전용 파일 로그 -->
    <appender name="ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- ERROR 레벨만 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>NEUTRAL</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <!-- scheduler MDC 태그 있으면 제외 -->
        <filter class="com.paramount.pmx.logging.MdcFilter">
            <mdcKey>logType</mdcKey>
            <mdcValue>scheduler</mdcValue>
            <acceptOnMatch>false</acceptOnMatch>
        </filter>
        <file>${SUB_LOG_PATH}/${ERR_LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SUB_LOG_PATH}/${ERR_LOG_FILE_NAME}_%d{yyyy-MM-dd}_%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>${MAX_SIZE}</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>${MAX_DAY}</maxHistory>
        </rollingPolicy>
    </appender>

    <appender name="SCHEDULER" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- scheduler MDC 로그만 저장 -->
        <filter class="com.paramount.pmx.logging.MdcFilter">
            <mdcKey>logType</mdcKey>
            <mdcValue>scheduler</mdcValue>
            <acceptOnMatch>true</acceptOnMatch>
        </filter>
        <file>${SUB_LOG_PATH}/${SCHEDULER_LOG_FILE_NAME}.log</file>
        <encoder><pattern>${LOG_PATTERN}</pattern></encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SUB_LOG_PATH}/${SCHEDULER_LOG_FILE_NAME}_%d{yyyy-MM-dd}_%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP"><maxFileSize>${MAX_SIZE}</maxFileSize></timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>${MAX_DAY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 스케줄러 에러 전용 appender -->
    <appender name="SCHEDULER_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- ERROR 레벨만 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>NEUTRAL</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <!-- scheduler MDC 태그 있을 때만 -->
        <filter class="com.paramount.pmx.logging.MdcFilter">
            <mdcKey>logType</mdcKey>
            <mdcValue>scheduler</mdcValue>
            <acceptOnMatch>true</acceptOnMatch>
        </filter>

        <file>${SUB_LOG_PATH}/${SCHEDULER_ERR_LOG_FILE_NAME}.log</file>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${SUB_LOG_PATH}/${SCHEDULER_ERR_LOG_FILE_NAME}_%d{yyyy-MM-dd}_%i.log</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
                <maxFileSize>${MAX_SIZE}</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
            <maxHistory>${MAX_DAY}</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- 로그 레벨별 설정 -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR"/>
        <appender-ref ref="SCHEDULER"/>
        <appender-ref ref="SCHEDULER_ERROR"/>
    </root>

</configuration>
